# Copy this file to .env and fill in local credentials. Never commit .env.
BIND_HOST=127.0.0.1
FRONTEND_PORT=18080
HTTP_PORT=5000
WEBSOCKET_PORT=5001
STARTUP_TIMEOUT_SECONDS=45
SHUTDOWN_DRAIN_SECONDS=10
BACKEND_PYTHON=python
RUNTIME_STATE_DIR=runtime
CAMERA_ID=camera-01
CAMERA_RTSP_URL=rtsp://user:password@camera-ip:554/Streaming/Channels/102

# Disabled in a clean clone so the Agent Runtime and /alarm API work without private weights.
# Set to 1 after placing a compatible local model under models/.
VISION_ENABLED=0
VISION_PROFILE=yolo26
VISION_MODEL_PATH=models/yolo26n_safety6_demo_best.pt
VISION_DEVICE=auto
VISION_CONFIDENCE=0.35
VISION_IMAGE_SIZE=640
VISION_CLASS_MAP={"head":5,"forktruck":4}
VISION_INTERVAL_SECONDS=0.4
VISION_MIN_HITS=3
VISION_EVENT_COOLDOWN_SECONDS=15
VISION_REQUIRE_PPE=1
# Automatically arm detection once both the model and RTSP stream are ready.
VISION_AUTO_START=1

LLM_MODE=ollama
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=20
LLM_MAX_INFLIGHT=2
# Text context only; image tokens are accounted for by the model runtime.
CONTEXT_TOKEN_BUDGET=1200
SOP_CATALOG_PATH=knowledge/sop/safety_procedures.json
SOP_TOP_K=3
SOP_MIN_SCORE=3.0

NOTIFY_PLATFORM=dingtalk
NOTIFY_WEBHOOK=
# DingTalk alarm messages are not sent unless the public evidence image is reachable.
NOTIFY_IMAGE_REQUIRED=1
NOTIFY_IMAGE_CHECK_ATTEMPTS=3
NOTIFY_IMAGE_CHECK_TIMEOUT_SECONDS=5
# Optional external notifier evidence base. The supervisor never opens a tunnel.
PUBLIC_URL=

# Optional worker identity. Blank generates a unique identity per process.
RUNTIME_OWNER_ID=
RUN_LEASE_SECONDS=30
RUN_HEARTBEAT_SECONDS=5
RUN_RECOVERY_SCAN_SECONDS=5
